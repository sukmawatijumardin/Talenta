# ============================================
# ITAKA — Environment Configuration
# Salin file ini menjadi .env lalu isi nilainya
# ============================================

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Authentication ---
# Kunci rahasia untuk menandatangani JWT token (WAJIB diganti!)
JWT_SECRET=ganti-dengan-kunci-rahasia-yang-kuat-dan-panjang

# Kode akses guru (pisahkan dengan koma)
GURU_CODES=123456,112233,GURU2026,KEPSEK-ITAKA

# Durasi token JWT (contoh: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# --- Baserow (Opsional) ---
# Kosongkan jika tidak menggunakan Baserow
# URL instance Baserow self-hosted Anda
BASEROW_URL=http://localhost:8080
# Database Token dari Baserow (bukan JWT)
BASEROW_TOKEN=
# Table ID untuk tabel siswa di Baserow
BASEROW_TABLE_STUDENTS_ID=
# Table ID untuk tabel dokumen di Baserow
BASEROW_TABLE_DOCUMENTS_ID=

# --- Upload ---
# Ukuran maksimal file upload dalam bytes (default: 10MB)
MAX_FILE_SIZE=10485760
